  "initial_documents": [
    {
      "document_id": "doc_compensation_policy_v1",
      "document_type": "compensation_policy",
      "title": "云溪县柳林村整体搬迁补偿安置方案",
      "status": "published",
      "policy_version": "policy-v1",
      "public_scope": ["全村36户", "县级相关部门"],
      "required_countersign_ids": ["npc_feng_jingzhi", "npc_zhao_jianguo"],
      "content": "云政发〔游戏年度〕1号。经上级批准，柳林村36户纳入整体搬迁，县级专项资金总盘8000万元，其中既有前期协调费200万元，当前可支配预算7800万元。合法住宅按结构计价：砖混0.18万元/㎡、砖木0.15万元/㎡、土木瓦房0.12万元/㎡、简易砖房0.13万元/㎡；认定宅基地0.06万元/㎡；承包地6万元/亩；搬迁费2万元/户；过渡费0.12万元/人/月，最长12个月；公开时间窗内签约奖励2万元/户。逐户合同必须以实测底账和真实资源为准，任何干部、村民代表不得代替其他家庭签字。"
    }
  ],
