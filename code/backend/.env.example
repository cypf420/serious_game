# 复制为 .env 后填写；.env 已被仓库根目录 .gitignore 排除。
GAME_ENVIRONMENT=sandbox
GAME_REPOSITORY=sqlite
GAME_DATABASE_PATH=data/serious_game.db
GAME_MYSQL_URL=
RESEARCH_MYSQL_URL=

AUTH_COOKIE_NAME=serious_game_session
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=28800
AUTH_REQUIRED=false
ALLOW_SELF_REGISTRATION=false

CONSENT_VERSION=draft-consent-v1
CONSENT_DOCUMENT_HASH=sha256:draft
CONSENT_MODEL_PROVIDER=未配置
CONSENT_PROCESSING_REGION=未配置
REQUIRE_MODEL_CONSENT=false
RAW_TEXT_RETENTION_DAYS=180

# 32 字节随机值的 URL-safe Base64；不要提交真实值。
FIELD_ENCRYPTION_KEY_ENV=SERIOUS_GAME_FIELD_KEY
FIELD_ENCRYPTION_KEY_ID=local-dev
SERIOUS_GAME_FIELD_KEY=

RESEARCH_ENABLED=false
EXPERIMENT_ID=
EXPERIMENT_GROUPS=
EXPERIMENT_ASSIGNMENT_SALT=
GOVERNANCE_AUDIT_SALT=local-dev-governance-audit
RETENTION_POLICY_VERSION=draft-retention-v1

# none：不提供服务器默认接口，玩家在登录界面配置个人 API。
# openai_compatible：管理员提供一个可选的服务器默认接口。
ROLE_LLM_PROVIDER=none
ROLE_LLM_BASE_URL=https://api.qianzhang-ai.cn/v1
ROLE_LLM_MODEL=qwen3.6-plus
# 行政文书独立审校 Agent；与合同审校配置分离。
DOCUMENT_AUDIT_LLM_MODEL=qwen3.6-plus
# 合同专业审校可使用独立模型；留空不被允许，默认可与角色模型相同。
CONTRACT_AUDIT_LLM_MODEL=qwen3.6-plus
ROLE_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
DASHSCOPE_API_KEY=

# 本地终端的自由交谈等待 35 秒；失败时按真实网关错误契约返回，不生成替代台词。
ROLE_LLM_TIMEOUT_SECONDS=15
ROLE_LLM_MAX_RETRIES=2
ROLE_LLM_MAX_OUTPUT_TOKENS=700
ROLE_LLM_MAX_CALLS_PER_SESSION=1500
ROLE_LLM_MAX_TOKENS_PER_SESSION=3000000
