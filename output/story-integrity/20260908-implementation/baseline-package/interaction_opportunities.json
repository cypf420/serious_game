{
  "schema_version": 2,
  "conversation_contexts": {
    "opp_d02_wu_xiuying_first_talk": {
      "opening_narrative": "专班名单刚定下来，你带着新摸出的派系图下村核实。坡道上，吴秀英拎着一篮刚摘的青菜迎面走来。旁人见了这位教过村里三代人的老教师都客气三分；她没有躲你，只淡淡打了个招呼。你意识到，她正是能帮你读懂柳林村人情脉络的人，于是停下脚步，请她说几句村里的实情。",
      "conversation_goal": "弄清周氏宗族、散姓和关键村民之间的关系，并听取她对搬迁工作的真实顾虑。"
    },
    "opp_d03_zhou_dashan_first_talk": {
      "opening_narrative": "吴秀英点破村里的派系之后，你决定先见掌握村务和周氏宗族话语权的周大山。村委会院里刚散完一场议事，他让其他人先走，把搪瓷茶缸往桌上一放，示意你坐。你们都清楚，搬迁若绕开他，后面的三十六户只会更加难谈。",
      "conversation_goal": "了解村委会和周氏宗族的正式立场，试探祖坟、祠堂、集体利益与签约之间的真实阻力。"
    },
    "opp_31_zhang_li_contact": {
      "opening_narrative": "市委巡察组已经进驻云溪。你带着阶段材料来到巡察组临时办公室，请求就搬迁进度、干部作风和程序风险单独说明情况。张立合上卷宗，让工作人员带上门，显然准备把每一句话都放到证据和程序的尺子上衡量。",
      "conversation_goal": "说明当前工作并核实巡察关注点；只能用事实、材料和合法程序争取他的判断。"
    },
    "opp_16_zhao_jianguo_contact": {
      "opening_narrative": "补偿盘子、部门配合和本地关系网逐渐缠到一起，你绕不开分管资金与项目的赵建国。你约他在县政府小会议室碰面。他端着茶坐下，仍是一副老同志替年轻干部把关的口吻，等你先说明来意。",
      "conversation_goal": "就预算、项目推进和部门协作交换意见，并试探他对旧账与本地关系网的态度。"
    },
    "opp_18_qian_wei_contact": {
      "opening_narrative": "宏达方面再次催问开工时间和补偿边界。你没有在酒桌上见钱伟，而是把他请到政府接待室正式谈。钱伟带着项目材料准时出现，笑容周全，桌上的每个数字却都牵着企业的工期和利益。",
      "conversation_goal": "核实企业诉求、资金边界与环保责任，判断钱伟是在合作、试探还是施压。"
    },
    "opp_20_liu_san_contact": {
      "opening_narrative": "走访记录与村账之间出现了几处对不上的地方。为避开周大山和村委会其他人的视线，你让人私下通知刘三，傍晚在镇上的一间空办公室见面。刘三进门前回头看了两次，坐下后一直攥着杯沿。",
      "conversation_goal": "从经手账目的人口中核对补偿、村账和资金流向，同时判断他最害怕什么。"
    },
    "opp_26_chen_mo_contact": {
      "opening_narrative": "关于清江污染和村民体检单的消息开始从官方渠道之外冒出来。你通过吴秀英留下的线索联系上陈默，约在县城一间不起眼的茶馆见面。他把手机扣在桌上，没有开录音，先问你究竟想查清问题，还是只想控制报道。",
      "conversation_goal": "确认记者掌握的信息边界，讨论证据核验与公共披露风险，但不能要求他放弃独立判断。"
    },
    "opp_22_shi_wenbin_contact": {
      "opening_narrative": "环保站的公开报表和你听到的河道情况并不完全一致。石文斌既是环保站职工，又是柳林村人，你没有把他叫到单位问话，而是在下班后约到河堤边。远处就是宏达厂区，他站得离你半步远，显然仍在掂量该以哪一种身份开口。",
      "conversation_goal": "核实监测流程与河道异常，给他足够安全感，让他只谈自己亲历和经手的事实。"
    },
    "opp_03_zhou_kuiyuan_contact": {
      "opening_narrative": "摸清周氏宗族的分量后，你到祠堂边拜访负责族中礼仪和祖坟事务的周奎元。他刚给香案掸完灰，没有请你进正堂，只在廊下摆了两张竹椅。对他而言，这场搬迁首先不是价钱，而是香火和体面往哪里安放。",
      "conversation_goal": "了解祖坟、祠堂和祭祀安排的底线，寻找不把宗族体面简单折成现金的解决办法。"
    },
    "opp_03_zhou_mancang_contact": {
      "opening_narrative": "走访中有人告诉你，周家并非所有人都只听族长一句话，周满仓尤其认账不认人。你带着公开补偿口径来到他家院坝。他搬来凳子，却先把计算器和一叠旧票据摆到桌上，意思很明白：账算不清，别的话都不用谈。",
      "conversation_goal": "把补偿算法、先后次序和公开标准讲清楚，以可核对的账争取他的判断。"
    },
    "opp_03_he_tiezhu_contact": {
      "opening_narrative": "第五十六日，何铁柱自己上了县政府的楼。他把孙子血铅二百八十七的检测单拍在你桌上，又用一张年轻时的军装照压住纸角。他没有喊，只问三年前那次体检为什么没人告诉他。你知道，这场谈话只能从孩子的治疗和被隐瞒的事实谈起。",
      "conversation_goal": "先听清他拒签背后的家庭与健康顾虑，以事实和担当回应，而不是逼他表态。"
    },
    "opp_03_tan_laoliu_contact": {
      "opening_narrative": "谭老六多次在走访名单旁写下旧案两个字。你决定在矛盾被他带到县外之前亲自听一遍。信访接待室里，他抱着一只磨破边的文件袋坐在最靠门的位置，见你进来就把多年积下的材料拍在桌上。",
      "conversation_goal": "听清旧案诉求并区分事实、怨气和现实条件，避免用压制或空头承诺把矛盾继续推高。"
    },
    "opp_03_ma_changshun_contact": {
      "opening_narrative": "村口小卖部是柳林村消息最快的地方。你以普通走访的方式进店，马长顺正给几名村民找零钱；人散后，他把柜台边的折叠椅递给你。谁家在观望、谁家刚改口，他未必最权威，却往往最先听见。",
      "conversation_goal": "了解村中近期风向和普遍顾虑，同时辨别哪些只是传言，避免把闲话当成证据。"
    },
    "opp_03_ning_dehai_contact": {
      "opening_narrative": "第七十日，未决名册只剩下几户，郑向东把宁德海的名字放在最上面。你亲自来到宁家，没有拿他在市局工作的儿子说事，只带了公示表、代签记录和能够逐项核对的程序材料。这个入党四十一年的老人没有立刻开门；你必须先让他确认，纸上的每一个名字都经得起追问。",
      "conversation_goal": "从政策、程序和党员责任切入，听取他对带头签约及村内稳定的真实判断。"
    },
    "opp_03_yuan_guilan_contact": {
      "opening_narrative": "走访名单显示袁桂兰家是低保困难户，家中还有长期需要照护的病人。你没有带大队人马，只和工作人员提着政策材料登门。屋里药味很重，她一边招呼你坐，一边下意识把一叠缴费单压在桌布下面。",
      "conversation_goal": "弄清搬迁对照护、医疗和基本生活的具体影响，让困难得到可兑现的制度回应。"
    },
    "opp_03_yang_bo_contact": {
      "opening_narrative": "第五十四日，吴秀英把返乡青年杨波带到安置方案公示栏前。杨波既懂村里的人情，也习惯在网上比较各地政策；他没有先问补偿数字，而是指着创业、入学和网络配套三栏，问这些承诺敢不敢让全村逐项核验。经吴秀英引见，你们第一次有了正式谈话的由头。",
      "conversation_goal": "了解年轻返乡户对公开、公平和未来生计的期待，并判断网络舆论可能如何发酵。"
    },
    "opp_03_lao_juetou_contact": {
      "opening_narrative": "第七十七日，老倔头没有坐工作组的车，自己骑了一个多小时到安置小区。他把自行车靠在铁门上，站在毛坯楼前，只说要看的不是照片，是房。此前名册上的沉默到这一刻才有了明确入口：让他亲眼核验一套真正能住、看完不会拆掉的房子。",
      "conversation_goal": "耐心确认他对祖屋、子女和安置房的真实顾虑；少说官话，让可验证的安排替你说话。"
    },
    "opp_03_miao_xiwang_contact": {
      "opening_narrative": "第二十五日的台账已经让你知道苗喜旺是二十万元特例，但直到第七十八日，他才托人捎话主动求见。郑向东把他领进办公室时，贺兴邦带来的血铅名册正放在桌上。苗喜旺不再谈那笔特例，只问孩子的复检、治疗和费用什么时候能逐项落实。",
      "conversation_goal": "讲清旧约与重签规则，同时听取他对家庭生计和孩子健康安排的具体要求。"
    },
    "opp_03_deng_shouben_contact": {
      "opening_narrative": "第八十四日，整改清单把安置房交付、独居老人搬运和医疗兜底排到最前。邓守本因此被请到现场逐项确认：哪一套房真正交付，谁负责搬运，晚年照护由谁承接。对这个无儿无女的老人而言，只有这些安排落到书面并由本人见证，才构成一次可继续的谈话。",
      "conversation_goal": "理解祖屋对独居老人的意义，讨论晚年安置与尊严，而不是只重复补偿金额。"
    },
    "opp_33_jiang_chongyue_contact": {
      "opening_narrative": "巡察压力和搬迁风险同时上升，若要公开处理干部、项目或环评问题，县委书记蒋崇岳的态度无法绕开。你带着风险清单和备选方案走进他的办公室。他没有寒暄，只让你把最坏情况和代价先讲清楚。",
      "conversation_goal": "用可验证的风险比较说明行动或不行动的后果，争取县委层面的授权或默许。"
    },
    "opp_03_zheng_xiangdong_contact": {
      "opening_narrative": "一天的走访和会议告一段落，郑向东抱着新收的材料回到县长办公室。他把文件按来源排开，等你决定先从哪条线梳理。作为秘书，他能复述已掌握的信息和提醒日程，但不会替你把未经证实的猜测当结论。",
      "conversation_goal": "复盘已经掌握的事实、线索和待办，厘清下一步问题；不得要求他凭空推断未知内幕。"
    },
    "opp_07_sun_qiang_contact": {
      "opening_narrative": "镇里报来的进度与村里实际反应出现落差，你把属地负责人孙强叫来单谈。会议结束后其他人先离开，他留下来整理杯子，显然知道这次不能再用一张笼统的情况正常应付过去。",
      "conversation_goal": "核实基层执行中的真实阻力、资源缺口和推诿环节，明确可以兑现的支持与责任。"
    },
    "opp_16_feng_jingzhi_contact": {
      "opening_narrative": "补偿、安置和应急支出开始同时挤压县里的资金盘子。你让财政局长冯敬之带齐测算表到办公室。他把每笔钱的来源、用途和风险标了不同颜色，坐下第一句话就是先说清楚总盘子还剩多少。",
      "conversation_goal": "核实预算边界与资金合规路径，比较不同方案的真实财政代价。"
    },
    "opp_46_he_xingbang_contact": {
      "opening_narrative": "第七十八日，分管卫健的贺兴邦第一次带着完整血铅名册进入你的办公室。四个村孩子的检测数据此前一直压在他手上；现在苗喜旺就在门外等复检答复，他必须当面说明检查、复查、治疗和费用究竟怎样落实。",
      "conversation_goal": "核实检查、复查、救治和费用安排，明确哪些健康信息已经具备合法处理依据。"
    },
    "opp_31_luo_jian_contact": {
      "opening_narrative": "一批化验传真经县卫生院流转，时间和留底情况需要交叉确认。你找到经手这些材料的罗健，在档案室旁的小办公室核对。他把传真登记本摊开，只愿意回答自己亲手接收、复印和送出的部分。",
      "conversation_goal": "确认化验材料的传递链和留底情况，不迫使经手人猜测自己不知道的幕后决定。"
    },
    "opp_46_ke_qinian_contact": {
      "opening_narrative": "环保问题逐渐进入必须正式回答的阶段。你把环保站站长柯启年叫来，要求他带上公开报表、原始台账和监测流程说明。文件放上桌后，他先解释程序，再观察你究竟准备查到哪一步。",
      "conversation_goal": "核对公开数据与原始记录的差异，追问监测责任和后续整改，但不预设未经证实的结论。"
    },
    "opp_59_gu_keming_contact": {
      "opening_narrative": "市生态环境局迎检组在第五十九日抵达云溪。正式检查间隙，你请求与组长顾克明单独沟通当前风险和材料准备。临时会议室里，他把验收清单放在中间，明确表示只认现场、数据和闭环记录。",
      "conversation_goal": "围绕环保验收标准、现场风险和整改证据沟通，不能把巡察组与环保迎检组混为一谈。"
    },
    "opp_59_cui_guanglin_contact": {
      "opening_narrative": "旧信访材料可能解释谭老六反复提及的历史争议。你依程序来到信访办卷宗室，请崔广林调出对应登记。老同志戴上眼镜，把借阅手续推到你面前；签完字后，他才从柜里取出那只旧档案盒。",
      "conversation_goal": "只围绕卷宗中已有的登记、处理过程和缺口核实事实，不要求档案管理员替任何人推断动机。"
    },
    "opp_01_wang_fang_contact": {
      "opening_narrative": "王芳承担县电视台的公开报道任务，但她不是可由玩家随时发起自由会谈的角色。她只会在对应新闻场景中出现，玩家可从报道内容判断宣传口径。",
      "conversation_goal": "该人物为环境角色，不开放直接自由对话。"
    },
    "opp_d53_tan_laoliu_paid_recovery": {
      "opening_narrative": "此前的强压已经让谭老六彻底关上了门，但旧案卷宗中的缺口如今有了可以核对的依据。你带着明确的处理路径再次来到信访接待室，没有让人催他签字，只把能够兑现的步骤逐项放到桌上。他盯着材料看了很久，终于肯再听一次。",
      "conversation_goal": "承认旧案中已坐实的问题，说明可兑现的补救程序，争取在不抹去历史责任的前提下恢复沟通。"
    },
    "opp_d55_yuan_guilan_paid_recovery": {
      "opening_narrative": "复查费用由县里垫付、赔付换谅解的安排已经有了正式依据，你再次来到袁桂兰家。这一次你带来的不是口头安慰，而是办理清单、联系人和时间表。她把上次压在桌布下的缴费单重新拿了出来。",
      "conversation_goal": "逐项确认医疗复查、困难救助和搬迁后的照护安排，让承诺能够被她当场核对。"
    },
    "opp_d69_zhou_mancang_restart": {
      "opening_narrative": "此前错误的推进顺序让周满仓冷了心，常规走访已经无法重开谈判。第六十九日，你带着重新核过的账和纠正方案登门，先承认顺序上的问题，再把每一项计算依据摆出来。他没有请你进屋，却把院门留着，给了这场谈话最后一次机会。",
      "conversation_goal": "纠正此前失序的处理方式，以完整、可核验的账重新建立谈判基础。"
    }
  },
